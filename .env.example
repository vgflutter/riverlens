# Optional. Copy this file to .env; never commit .env.
OPENAI_API_KEY=
# Choose a Responses API model available to your OpenAI project.
# For screen analysis and screenshot transcription it must also accept image input.
OPENAI_MODEL=
# Optional model dedicated to screen analysis. Blank inherits OPENAI_MODEL.
# Example to benchmark: gpt-4.1-mini (image input, no reasoning step).
# Latency/accuracy depend on your project and game; no response-time guarantee.
OPENAI_SCREEN_MODEL=
# Maximum attempted paid calls per server start, across all AI features.
# This is not a dollar budget. 0 disables outgoing AI requests.
OPENAI_MAX_CALLS=20
